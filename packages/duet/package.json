{
  "name": "@duetso/agent",
  "version": "1.1.0",
  "description": "Duet CLI for local agents, workspaces and file sync",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aomni-com/open-duet.git"
  },
  "bin": {
    "duet": "dist/cli-entry.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/cli-entry.ts --target=bun --outdir=dist",
    "build:public": "bun scripts/build-public-package.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "bash ../../scripts/agent-tests.sh duet",
    "cli": "bun src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@electric-sql/pglite": "0.4.5",
    "@opentui/core": "0.2.5",
    "@repo/agent": "workspace:*",
    "@repo/contract": "workspace:*",
    "@repo/importers": "workspace:*",
    "@repo/sync-tunnel": "workspace:*",
    "ai": "7.0.105",
    "dedent": "1.7.2",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/ms": "2.1.0",
    "@types/node": "22.19.18",
    "e2b": "2.35.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@duetso/syncthing-darwin-arm64": "2.1.2",
    "@duetso/syncthing-darwin-x64": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
