{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "dotenvx",
        "run",
        "-f",
        ".env.local",
        "-f",
        ".env.staging",
        "--ignore=MISSING_ENV_FILE",
        "--",
        "bun",
        "--cwd=apps/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "lander",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd=apps/lander",
        "run",
        "dev"
      ],
      "port": 3002
    }
  ]
}
