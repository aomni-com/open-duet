{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev --port 3001",
    "lint": "oxlint",
    "start": "bun scripts/serve-static-export.ts",
    "test": "bun test scripts app examples && bun run verify:boundaries && bun run verify:content && bun run verify:endpoints && bun run verify:visual-coverage",
    "verify:boundaries": "bun scripts/check-boundaries.ts",
    "verify:build-output": "bun scripts/verify-build-output.ts",
    "verify:content": "bun scripts/verify-content.ts",
    "verify:endpoints": "bun scripts/verify-endpoints.ts",
    "endpoint:coverage:write": "bun scripts/verify-endpoints.ts --write",
    "verify:visual-coverage": "bun scripts/verify-visual-coverage.ts",
    "visual:coverage:write": "bun scripts/verify-visual-coverage.ts --write",
    "visual": "playwright test",
    "visual:approve": "playwright test --update-snapshots=changed",
    "visual:approve:force": "playwright test --update-snapshots=all"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.10",
    "@repo/contract": "*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-pretty-code": "^0.14.1",
    "remark-gfm": "catalog:",
    "shiki": "^3.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@repo/typescript-config": "*",
    "@types/bun": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
