    "@repo/fake-oauth-issuer": "*",
    "@repo/official-agents-seed": "*",
    "@repo/service-catalog": "*",
    "@repo/skills-registry": "*",
    "@repo/web-locale": "*",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "^3.1.0",
    "ai": "^7",
    "convex": "^1.42.1",
    "hono": "^4.10.8",
    "zod": "^4.4.3",
    "@repo/agent": "workspace:*"
  },
  "devDependencies": {
    "@repo/backend": "*",
    "@repo/gateway": "*",
    "@repo/test-harness": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "catalog:",
