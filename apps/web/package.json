{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev --port 3000",
    "lint": "oxlint",
    "proxy:workbench": "bun scripts/proxy-workbench.ts",
    "start": "next start --port 3000",
    "test": "bun test ./scripts ./app ./src ./spa ./components && bun run verify:boundaries && bun run verify:visual-coverage",
    "verify:boundaries": "bun scripts/check-boundaries.ts",
    "verify:build-output": "bun scripts/verify-build-output.ts",
    "verify:visual-coverage": "bun scripts/verify-visual-coverage.ts",
    "visual:coverage:write": "bun scripts/verify-visual-coverage.ts --write",
    "visual": "playwright test",
    "visual:approve": "playwright test --update-snapshots=changed",
    "visual:approve:force": "playwright test --update-snapshots=all"
  },
