{
  "name": "lander",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev --port 3002",
    "lint": "oxlint",
    "public-paths:write": "bun scripts/write-spanish-public-paths.ts",
    "start": "next start --port 3002",
    "test": "bun test scripts app src lib proxy.test.ts && bun run verify:boundaries && bun run verify:public-content && bun run verify:visual-coverage",
    "verify:boundaries": "bun scripts/check-product-copy.ts",
    "verify:build-output": "bun scripts/verify-build-output.ts",
    "verify:public-content": "bun scripts/verify-public-content.ts",
    "verify:visual-coverage": "bun scripts/verify-visual-coverage.ts",
    "visual:coverage:write": "bun scripts/verify-visual-coverage.ts --write",
    "visual": "playwright test",
    "visual:approve": "playwright test --update-snapshots=changed",
    "visual:approve:force": "playwright test --update-snapshots=all"
  },
  "dependencies": {
    "@imagekit/next": "^2.1.5",
    "@paper-design/shaders-react": "^0.0.61",
    "@phosphor-icons/react": "catalog:",
