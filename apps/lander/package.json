    "@repo/contract": "*",
    "@repo/ui": "*",
    "@repo/web-locale": "*",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "convex": "^1.42.1",
    "cookies-next": "^6.1.1",
    "framer-motion": "^11.18.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "next": "catalog:",
    "next-intl": "^4.13.0",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-lowlight": "^3.0.0",
    "reading-time": "^1.5.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "catalog:",
